# TEMPLATE ONLY. Existing Nginx 1.28.3; MIQA TLS strategy still pending.
# Dedicated host only; do not replace existing ERP/default server blocks.
# Certificate paths are placeholders; review TLS and Cloudflare trust first.
server {
    listen 443 ssl;
    server_name api-store.solucionesmicaela.com;
    ssl_certificate /etc/miqa-store/tls/CHANGE_ME-fullchain.pem;
    ssl_certificate_key /etc/miqa-store/tls/CHANGE_ME-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;
    # Health is for localhost monitoring; never forwarded publicly by this example.
    location /actuator { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite untrusted forwarding headers; do not append client input.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    # No /media alias/controller/upload is enabled.
    location / { return 404; }
}
