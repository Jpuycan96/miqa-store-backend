# TEMPLATE ONLY. VPS uses global Java 21 at /usr/bin/java.
[Unit]
Description=MIQA Store API
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=miqa-store
Group=miqa-store
WorkingDirectory=/opt/miqa-store/app
EnvironmentFile=/etc/miqa-store/miqa-store.env
UnsetEnvironment=ADMIN_BOOTSTRAP_USERNAME ADMIN_BOOTSTRAP_PASSWORD
ExecStart=/usr/bin/java -Xms64m -Xmx192m -jar /opt/miqa-store/app/miqa-store-backend.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
SuccessExitStatus=143
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/miqa-store/media
RestrictSUIDSGID=true
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=miqa-store

[Install]
WantedBy=multi-user.target
