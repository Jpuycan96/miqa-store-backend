# TEMPLATE ONLY. Not installed or executed.
[Unit]
Description=MIQA Store PostgreSQL backup
After=network.target

[Service]
Type=oneshot
User=root
Group=root
LoadCredential=pgpass:/etc/miqa-store/backup.pgpass
ExecStart=/bin/bash /opt/miqa-store/scripts/backup-miqa-store.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/miqa-store/backups
RestrictSUIDSGID=true
CapabilityBoundingSet=
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
